[user]

[alias]
    lg = log --date-order --date=relative --graph --pretty=format:'%C(yellow)%h%C(reset) <%C(cyan)%ad%C(reset), %C(dim white)%<(12,trunc)%an%C(reset)> %C(magenta)|%C(reset) %s %C(green)%d%C(reset)'
    sclone = clone --recurse-submodules
    supdate = submodule update --recursive --init
    sfetch = fetch --recurse-submodules
    spull = pull --recurse-submodules
    spush = push --recurse-submodules=on-demand

[commit]
    template = ~/.gitmessage

[core]
    editor = vim
    excludesfile = ~/.gitignore
    pager = less -S

[color]
    ui = auto

[credential]
    helper = store

